{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "gomod",
    "github-actions"
  ],
  "ignorePaths": [
    "**/testdata/**",
    "**/node_modules/**"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "description": "Sample modules link each other via local replace; nothing to look up",
      "matchPackageNames": [
        "example.com/**"
      ],
      "enabled": false
    }
  ]
}
